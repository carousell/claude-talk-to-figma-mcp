{
  "name": "Claude Talk to Figma Plugin",
  "id": "claude-mcp-plugin",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma",
    "figjam"
  ],
  "permissions": ["teamlibrary"],
  "networkAccess": {
    "allowedDomains": ["*"],
    "devAllowedDomains": ["*"],
    "reasoning": "Plugin can enable a connection to a user-configured WebSocket server, so the domain cannot be known in advance."
  },
  "documentAccess": "dynamic-page",
  "enableProposedApi": true,
  "enablePrivatePluginApi": true
}